# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socialmedia
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
# REDIS_SSL_ENABLED must be false for a plain local/Docker Compose Redis and true for
# TLS-only managed Redis (e.g. Upstash) - it does NOT auto-detect, so mismatching it
# with your target will fail the connection.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Kafka Configuration
KAFKA_SERVERS=localhost:9092

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-must-be-at-least-256-bits-long-for-security
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# OAuth2 Google Configuration
# Login only works end-to-end with real values here - the defaults are placeholders
# and Google will reject the redirect_uri otherwise.
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Frontend origin OAuth2 redirects the browser back to after a successful Google login
FRONTEND_URL=http://localhost:3000

# Server Configuration
SERVER_PORT=8080
